rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isProfessorAdmin() {
      return isSignedIn() && adminData().role in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return isSignedIn() && adminData().role == 'superadmin';
    }

    function isRepresentanteOf(turmaId) {
      return isSignedIn()
        && adminData().role == 'representante'
        && adminData().turmaId == turmaId;
    }

    function canManage(turmaId) {
      return isSuperAdmin() || isRepresentanteOf(turmaId);
    }

    // Qualquer representante (de qualquer turma) ou o super-admin — usado só
    // para criar eventos gerais, que não pertencem a uma turma específica.
    function isAnyAdmin() {
      return isSignedIn() && adminData().role in ['representante', 'superadmin'];
    }

    // Evento geral (turmaId nulo): quem criou ou o super-admin podem editar/excluir.
    // Atividade de turma: continua exigindo canManage() daquela turma.
    function canManageActivity(data) {
      return data.turmaId == null
        ? (isSuperAdmin() || (isSignedIn() && data.createdBy == request.auth.uid))
        : canManage(data.turmaId);
    }

    function canCreateActivity(data) {
      return data.createdBy == request.auth.uid
        && (data.turmaId == null ? isAnyAdmin() : canManage(data.turmaId));
    }

    function hasActivityShape(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 2000
        && data.type in ['tarefa', 'licao', 'trabalho', 'prova', 'evento']
        && (data.subject == null || (data.subject is string && data.subject.size() > 0 && data.subject.size() <= 120))
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.time == null || (data.time is string && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (data.turmaId == null || (data.turmaId is string && data.turmaId.size() > 0));
    }

    function isValidActivity(data) {
      return hasActivityShape(data);
    }

    function isValidSuggestion(data) {
      return hasActivityShape(data)
        && data.turmaId is string && data.turmaId.size() > 0
        && data.status == 'pendente'
        && data.createdAt == request.time;
    }

    function isValidFeedback(data) {
      return data.message is string && data.message.size() > 0 && data.message.size() <= 2000
        && (data.turmaId == null || (data.turmaId is string && data.turmaId.size() > 0))
        && data.createdAt == request.time;
    }

    function isValidAnnouncement(data) {
      return data.message is string && data.message.size() > 0 && data.message.size() <= 500
        && data.updatedAt == request.time;
    }

    // Documento de permissão de cada usuário autenticado.
    // Criado manualmente pelo Console do Firebase — nunca por escrita do app.
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Horários usados pelo site Cadê o professor?.
    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, update, delete: if isProfessorAdmin();
    }

    // Atividades (tarefas, lições, trabalhos, eventos) de uma turma, ou eventos
    // gerais (turmaId nulo) visíveis em todas as turmas.
    match /activities/{activityId} {
      allow read: if true;

      allow create: if isValidActivity(request.resource.data)
        && canCreateActivity(request.resource.data);

      // Precisa poder gerenciar a turma/escopo ATUAL (antes da edição) e também
      // ter permissão sobre o turmaId NOVO — assim dá pra converter turma <-> geral,
      // mas sem burlar quem pode criar/gerenciar cada tipo.
      allow update: if canManageActivity(resource.data)
        && (request.resource.data.turmaId == null ? isAnyAdmin() : canManage(request.resource.data.turmaId))
        && isValidActivity(request.resource.data);

      allow delete: if canManageActivity(resource.data);
    }

    // Sugestões de atividades enviadas por alunos (sem login). Expira sozinha em
    // 30 dias via política de TTL configurada no Console sobre o campo createdAt.
    match /suggestions/{suggestionId} {
      // Leitura de UM documento pelo ID: usada pelo aluno para acompanhar a própria
      // sugestão (o ID guardado no localStorage funciona como um token de acesso).
      allow get: if true;

      // Listagem/consulta (ex.: "todas as sugestões da minha turma") só para quem
      // gerencia aquela turma — evita expor as sugestões de todo mundo publicamente.
      allow list: if canManage(resource.data.turmaId);

      allow create: if isValidSuggestion(request.resource.data);

      // Representante/superadmin só pode mudar o status (aprovar/rejeitar), nunca
      // reescrever o conteúdo da sugestão.
      allow update: if canManage(resource.data.turmaId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['aprovada', 'rejeitada'];

      allow delete: if canManage(resource.data.turmaId);
    }

    // Comentários de melhoria sobre o site (não são por turma). Só o super-admin lê.
    match /feedback/{feedbackId} {
      allow create: if isValidFeedback(request.resource.data);
      allow get, list, delete: if isSuperAdmin();
      allow update: if false;
    }

    // Aviso único mostrado para todo mundo (documento fixo "latest"). Só o
    // super-admin publica/edita/remove; a leitura é pública, sem login.
    match /announcement/{announcementId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSuperAdmin() && isValidAnnouncement(request.resource.data);
      allow delete: if isSuperAdmin();
    }
  }
}
